# --- DATABASE CONFIG ---
DATABASE_URL=postgresql://travel_user:SECURE_PASSWORD@postgres:5432/travel_os_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
REDIS_URL=redis://redis:6379/0
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# --- SECURITY & AUTH ---
JWT_SECRET=GENERATE_A_64_CHAR_HEX_SECRET_FOR_PROD
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=prod-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=prod-google-client-secret
GOOGLE_REDIRECT_URI=https://travelos.com/api/v1/auth/google/callback

# --- LLM PROVIDERS ---
OPENAI_API_KEY=sk-proj-prod-openai-key
ANTHROPIC_API_KEY=sk-ant-prod-anthropic-key
GEMINI_API_KEY=prod-gemini-key
GROQ_API_KEY=gsk_prod-groq-key

# --- PROVIDER ARCHITECTURE & CONFIGURATION ---
PROVIDER_MODE=live
ENABLE_LIVE_INVENTORY=true
LIVE_CAB_PROVIDER=amadeus
LIVE_CAR_PROVIDER=duffel
LIVE_PROVIDER_TIMEOUT=15
LIVE_PROVIDER_TESTS=false
ALLOW_DEMO_FALLBACK=false

# --- EXTERNAL INTEGRATIONS ---
AMADEUS_ENV=production
AMADEUS_CLIENT_ID=prod-amadeus-api-key
AMADEUS_CLIENT_SECRET=prod-amadeus-api-secret
AMADEUS_BASE_URL=https://api.amadeus.com

AVIATIONSTACK_API_KEY=prod-aviationstack-key
RAPIDAPI_KEY=prod-rapidapi-key
RAPIDAPI_HOST=booking-com15.p.rapidapi.com

GOOGLE_MAPS_API_KEY=prod-google-maps-key
OPENWEATHER_API_KEY=prod-openweather-key
GEOAPIFY_API_KEY=prod-geoapify-key
EXCHANGE_RATE_API_KEY=prod-exchangerate-key

FIREBASE_SERVICE_ACCOUNT_JSON=prod-firebase-base64

STRIPE_API_KEY=sk_live_prod_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_prod_stripe_secret

RAZORPAY_KEY_ID=rzp_live_prod_key_id
RAZORPAY_KEY_SECRET=prod_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=prod_razorpay_webhook_secret

RESEND_API_KEY=re_prod_key
RESEND_FROM_EMAIL=concierge@travelos.com

SENDGRID_API_KEY=SG.prod-key
SENDGRID_FROM_EMAIL=alerts@travelos.com

TWILIO_ACCOUNT_SID=AC_prod_sid
TWILIO_AUTH_TOKEN=prod_auth_token
TWILIO_PHONE_NUMBER=+18005550199

MSG91_AUTH_KEY=prod-msg91-key
MSG91_SENDER_ID=TRVLOS

DUFFEL_API_KEY=duffel_live_prod_key
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

HOTELBEDS_API_KEY=prod-hotelbeds-key
HOTELBEDS_SECRET=prod-hotelbeds-secret
HOTELBEDS_BASE_URL=https://api.hotelbeds.com

AIRALO_CLIENT_ID=prod-airalo-id
AIRALO_CLIENT_SECRET=prod-airalo-secret
AIRALO_BASE_URL=https://partnerapi.airalo.com/v2

VIATOR_API_KEY=prod-viator-key

S3_ACCESS_KEY_ID=prod-aws-access-key
S3_SECRET_ACCESS_KEY=prod-aws-secret-key
S3_BUCKET_NAME=travelos-prod-media
S3_ENDPOINT_URL=

SENTRY_DSN=https://prod-sentry-dsn@sentry.io/123456
