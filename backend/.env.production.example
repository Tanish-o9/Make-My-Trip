# ==============================================================================
# TRAVEL OS PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# WARNING: All keys marked [CRITICAL] must be set in your production platform 
# (e.g. Railway settings) with real, active credentials. Startup checks will 
# fail and block the application from loading if critical keys are missing.

# ── DATABASE CONFIG ───────────────────────────────────────────────────────────
# [CRITICAL] URL of the production PostgreSQL database (e.g. Neon, AWS RDS, GCP Cloud SQL)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=20

# [CRITICAL] Production Redis server URL (shared caching & rate limits)
REDIS_URL=redis://redis-production-host:6379/0

# Production ChromaDB vector store host & port
CHROMADB_HOST=chromadb-host
CHROMADB_PORT=8000

# ── SECURITY & AUTH ───────────────────────────────────────────────────────────
# [CRITICAL] At least 32-character long random secret used to sign JWT tokens
JWT_SECRET=production-random-hex-string-generate-using-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Google OAuth credentials
GOOGLE_CLIENT_ID=production-google-client-id
GOOGLE_CLIENT_SECRET=production-google-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/v1/auth/google/callback

# ── LLM PROVIDERS ─────────────────────────────────────────────────────────────
# At least one real, active key must be provided. Groq is cost-effective for tools.
GROQ_API_KEY=gsk_production_groq_key
OPENAI_API_KEY=sk-proj-production_openai_key
GEMINI_API_KEY=production_gemini_key
ANTHROPIC_API_KEY=production_anthropic_key

# ── PAYMENTS ──────────────────────────────────────────────────────────────────
# Stripe Production Keys
STRIPE_API_KEY=sk_live_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_stripe_production_webhook_secret

# Razorpay Production Keys (keys start with rzp_live_)
RAZORPAY_KEY_ID=rzp_live_production_key_id
RAZORPAY_KEY_SECRET=production_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=production_razorpay_webhook_secret

# ── TRAVEL PROVIDERS ──────────────────────────────────────────────────────────
# [CRITICAL] Duffel Live Key
DUFFEL_API_KEY=duffel_live_production_key
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

# [CRITICAL] Hotelbeds Live Keys
HOTELBEDS_API_KEY=production_hotelbeds_api_key
HOTELBEDS_SECRET=production_hotelbeds_secret
HOTELBEDS_BASE_URL=https://api.hotelbeds.com

# ── COMMUNICATION ─────────────────────────────────────────────────────────────
# Resend API Secret Key
RESEND_API_KEY=re_production_resend_key
RESEND_FROM_EMAIL=bookings@yourdomain.com

# Twilio SMS Production Keys
TWILIO_ACCOUNT_SID=production_twilio_sid
TWILIO_AUTH_TOKEN=production_twilio_token
TWILIO_PHONE_NUMBER=production_twilio_phone_number

# ── MAPS & WEATHER ────────────────────────────────────────────────────────────
# [CRITICAL] Google Maps API Key (Geocoding, Directions, Places enabled)
GOOGLE_MAPS_API_KEY=production_google_maps_key

# [CRITICAL] OpenWeather API Key (One Call API 3.0 enabled for historical queries)
OPENWEATHER_API_KEY=production_openweather_key

# ── OBJECT STORAGE ────────────────────────────────────────────────────────────
# Production AWS S3 credentials
S3_ACCESS_KEY_ID=production_aws_access_key
S3_SECRET_ACCESS_KEY=production_aws_secret_key
S3_BUCKET_NAME=production-travel-os-assets
S3_ENDPOINT_URL=https://s3.amazonaws.com

# ── MONITORING ────────────────────────────────────────────────────────────────
# Production Sentry configuration
SENTRY_DSN=https://sentry-key@o0.ingest.sentry.io/project-id
