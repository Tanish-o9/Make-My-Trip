# --- DATABASE CONFIG ---
DATABASE_URL=sqlite:///./travel_os.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# --- SECURITY & AUTH ---
JWT_SECRET=your-development-jwt-secret-key-make-it-secure
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- LLM PROVIDERS ---
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OLLAMA_ENDPOINT=http://localhost:11434

# --- PROVIDER ARCHITECTURE & CONFIGURATION ---
PROVIDER_MODE=demo
ENABLE_LIVE_INVENTORY=false
LIVE_CAB_PROVIDER=amadeus
LIVE_CAR_PROVIDER=duffel
LIVE_PROVIDER_TIMEOUT=15
LIVE_PROVIDER_TESTS=false
ALLOW_DEMO_FALLBACK=true

# --- EXTERNAL INTEGRATIONS ---
AMADEUS_ENV=test
AMADEUS_CLIENT_ID=your-amadeus-id
AMADEUS_CLIENT_SECRET=your-amadeus-secret
AMADEUS_BASE_URL=https://test.api.amadeus.com

AVIATIONSTACK_API_KEY=your-aviationstack-api-key
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=booking-com15.p.rapidapi.com

GOOGLE_MAPS_API_KEY=your-google-maps-key
OPENWEATHER_API_KEY=your-openweather-api-key
GEOAPIFY_API_KEY=your-geoapify-key
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

FIREBASE_SERVICE_ACCOUNT_JSON=your-firebase-service-account-json-base64

STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com

SENDGRID_API_KEY=your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=your-twilio-number

MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=TRVLOS

DUFFEL_API_KEY=your-duffel-api-key
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

HOTELBEDS_API_KEY=your-hotelbeds-key
HOTELBEDS_SECRET=your-hotelbeds-secret
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com

AIRALO_CLIENT_ID=your-airalo-client-id
AIRALO_CLIENT_SECRET=your-airalo-client-secret
AIRALO_BASE_URL=https://sandbox-partnerapi.airalo.com/v2

VIATOR_API_KEY=your-viator-api-key

S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET_NAME=your-s3-bucket-name
S3_ENDPOINT_URL=your-s3-endpoint-url-if-not-aws

SENTRY_DSN=your-sentry-dsn
