# ==========================================
# GHUMNE CHALE UNIFIED CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to '.env' and populate with your own credentials.
# Never commit real credentials to your git repository!

# --- DATABASE CONFIG ---
DATABASE_URL=sqlite:///./travel_os.db
REDIS_URL=redis://localhost:6379/0
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# --- SECURITY & AUTH ---
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- AI PROVIDERS & API KEYS ---
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GROQ_API_KEY=your_groq_api_key
OLLAMA_ENDPOINT=http://localhost:11434

# --- PAYMENT INTEGRATIONS (SANDBOX) ---
PAYMENT_MODE=test
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
STRIPE_API_KEY=your_stripe_api_key

# --- MAPS & WEATHER INTEGRATIONS ---
GOOGLE_MAPS_API_KEY=your_google_maps_key
OPENWEATHER_API_KEY=your_openweather_api_key
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret

# --- EMAIL & OTP NOTIFICATIONS ---
SENDGRID_API_KEY=your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=your_twilio_number
